# Gopher Chat on bare metal, https://metal.lynrummy.com: a test address on the
# prod droplet's Caddy for the gopher-metal droplet, which listens on port 80
# of its private card only (10.100.0.4, nyc2). The prod droplet's Caddyfile
# (angry-gopher's deploy/Caddyfile) imports /etc/caddy/sites/*.caddy, where this
# file is copied by hand. The body caps and security headers are lynrummy.com's.
metal.lynrummy.com {
	encode gzip

	@upload path_regexp up ^(/chat/c/[^/]+/[^/]+|/channel/[^/]+/[^/]+)/upload$
	request_body @upload {
		max_size 110MB
	}
	@notupload not path_regexp nup ^(/chat/c/[^/]+/[^/]+|/channel/[^/]+/[^/]+)/upload$
	request_body @notupload {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	reverse_proxy 10.100.0.4:80
}
